{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weave-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "dev": { "port": 8787 },
  "vars": { "BETTER_AUTH_URL": "http://localhost:5173", "FRONTEND_URL": "http://localhost:5173" },
  "d1_databases": [{ "binding": "DB", "database_name": "weave-auth", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "services": [{ "binding": "AGENTS", "service": "weave-agents", "entrypoint": "AgentsService" }]
}
